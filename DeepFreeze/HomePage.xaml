<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="DeepFreeze.HomePage"
             BackgroundImageSource="fridge1.jpg"
             Title="HomePage">

    <VerticalStackLayout>

        <Button
            x:Name="FridgeButton"
            Text="Fridge"
            Clicked="FridgeButton_Clicked"
            Margin="0,40,0,0"
            TextColor="White"
            HorizontalOptions="CenterAndExpand"
            BackgroundColor="Blue"
            FontSize="18"
            HeightRequest="80"
            WidthRequest="160"/>
        
        <Button
            x:Name="Balance"
            Text="Balance"
            Clicked="BalanceButton_Clicked"
            Margin="0,40,0,0"
            TextColor="White"
            HorizontalOptions="CenterAndExpand"
            BackgroundColor="Blue"
            FontSize="18"
            HeightRequest="80"
            WidthRequest="160"/>

        <Button
            x:Name="MessageButton"
            Text="Message"
            Clicked="MessageButton_Clicked"
            Margin="0,40,0,0"
            TextColor="White"
            HorizontalOptions="CenterAndExpand"
            BackgroundColor="Blue"
            FontSize="18"
            HeightRequest="80"
            WidthRequest="160"/>

        <Button
            x:Name="SettingsButton"
            Text="Settings"
            Clicked="SettingsButton_Clicked"
            Margin="0,40,0,0"
            TextColor="White"
            HorizontalOptions="CenterAndExpand"
            BackgroundColor="Blue"
            FontSize="18"
            HeightRequest="80"
            WidthRequest="160"/>

    </VerticalStackLayout>

</ContentPage>