<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="DeepFreeze.Fridge"
             BackgroundImageSource="fridge1.jpg"
             Title="Fridge">

    <VerticalStackLayout Padding="20" Spacing="15">
        <!-- Add New Drink Button -->
        <Button Text="Add New Drink" Clicked="AddDrinkButton_Clicked" />

        <!-- Drink List -->
        <CollectionView x:Name="DrinkCollection" SelectionMode="None">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Grid Padding="10" ColumnDefinitions="2*,1*,1*" RowSpacing="5">
                        <!-- Drink Name -->
                        <Label Text="{Binding Name}" FontSize="18" VerticalOptions="Center" />

                        <!-- Drink Amount -->
                        <Label Text="{Binding Amount}" FontSize="18" VerticalOptions="Center" HorizontalOptions="Center" />

                        <!-- Increment and Decrement Buttons -->
                        <StackLayout Orientation="Horizontal" HorizontalOptions="End">
                            <Button Text="-" WidthRequest="40" Clicked="OnDecrementClicked" />
                            <Button Text="+" WidthRequest="40" Clicked="OnIncrementClicked" />
                        </StackLayout>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </VerticalStackLayout>
</ContentPage>

